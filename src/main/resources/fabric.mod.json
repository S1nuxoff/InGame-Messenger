{
  "schemaVersion": 1,
  "id": "ingamemessenger",
  "version": "${version}",
  "name": "InGame Messenger",
  "description": "A messenger in the Minecraft chat: bubbles with faces, stickers and emoji, reactions, replies, @mentions, private chats, pictures, voice messages, polls and search through the whole history. Install it on the server and on the clients; players without it can still join and chat as usual.",
  "authors": ["S1nuxoff"],
  "contact": {
    "homepage": "https://live.sinuxoff.com/messenger/",
    "sources": "https://github.com/S1nuxoff/InGame-Messenger",
    "issues": "https://github.com/S1nuxoff/InGame-Messenger/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "ingamemessenger.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.sinuxoff.ingamemessenger.fabric.FabricMod"],
    "client": ["com.sinuxoff.ingamemessenger.fabric.FabricClient"]
  },
  "mixins": [
    "ingamemessenger.mixins.json",
    {"config": "ingamemessenger.hooks.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": "${loader_range}",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=${java}"
  },
  "breaks": {
    "chatpatches": "*",
    "chattools": "*",
    "chatting": "*"
  }
}
